<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 et plus (android:dataExtractionRules). Mêmes exclusions que
  regles_sauvegarde.xml, qui dit pourquoi chacune, mais il faut la répéter ici : Android 12 a séparé la
  sauvegarde cloud du transfert d'appareil à appareil, et ignore
  fullBackupContent dès l'API 31.

  Les DEUX blocs comptent. cloud-backup couvre la sauvegarde Google ;
  device-transfer couvre la copie vers un téléphone neuf, qui passe par un
  câble et non par le réseau, et qui sans cette ligne emporterait la base du
  moteur MLS alors que la sauvegarde cloud, elle, l'aurait laissée.

  ATTENTION : pas de tiret double dans ce commentaire, XML l'interdit.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="mls/" />
        <exclude domain="file" path="medias_dechiffres/" />
        <exclude domain="root" path="app_flutter/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="mls/" />
        <exclude domain="file" path="medias_dechiffres/" />
        <exclude domain="root" path="app_flutter/" />
    </device-transfer>
</data-extraction-rules>
