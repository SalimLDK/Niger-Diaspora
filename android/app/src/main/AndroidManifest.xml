<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    

    
    <!-- Permissions for location services -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.INTERNET" />
    
    <!-- Permissions for camera (QR code scanning) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!-- Permissions for audio recording -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Appels WebRTC : routage audio (écouteur / haut-parleur / Bluetooth).
         MODIFY_AUDIO_SETTINGS est requis par flutter_webrtc pour piloter
         AudioManager ; sans elle, setSpeakerEnabled() échoue sur certains OEM.
         flutter_webrtc ne déclare aucune permission dans son propre manifeste,
         c'est donc à l'app de le faire. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Les permissions d'appel restantes (MANAGE_OWN_CALLS,
         FOREGROUND_SERVICE_PHONE_CALL, WAKE_LOCK, VIBRATE) sont fusionnées
         depuis le manifeste de flutter_callkit_incoming. -->

    <!-- USE_FULL_SCREEN_INTENT retirée de la fusion, et ce n'est pas un choix.
         Google a REFUSÉ la mise à jour du 11 mars 2026 dessus : « l'utilisation
         de l'autorisation n'est pas directement liée à l'objectif principal de
         l'appli ». Cette permission est réservée aux applications dont la
         raison d'être est l'appel ou l'alarme ; Diaspo Niger est un réseau
         social qui propose des appels, ce qui ne suffit pas. La consigne du
         centre de conformité est explicite : la retirer de TOUS les codes de
         version, test compris. Tant qu'elle est présente, aucune mise à jour
         ne passe l'examen.

         Ce que ça coûte : un appel entrant n'ouvre plus d'écran plein sur un
         téléphone verrouillé, il arrive en notification prioritaire. Android
         dégrade tout seul, il n'y a ni plantage ni erreur à traiter.
         Ne pas rétablir sans un accord écrit de Google. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT"
        tools:node="remove" />

    <!-- Permissions for saving files to gallery -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" tools:replace="android:maxSdkVersion" />
    <!-- Lecture galerie (Android 13+) pour la galerie intégrée photo_manager -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    
    <!-- Required for Google Maps -->
    <uses-feature
        android:glEsVersion="0x00020000"
        android:required="true" />
    
    <!-- Background Location Service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- ACCESS_BACKGROUND_LOCATION retirée le 2026-09-09, sur refus de Google.
         Motif reçu par mail : « Missing Prominent Disclosure — Your app accesses
         the BACKGROUND_LOCATION permission without a prominent disclosure. »
         Deux envois (20 et 21) refusés dessus le même jour.

         La permission était **déclarée sans jamais être demandée** :
         `LocationService.requestBackgroundLocationPermission()` et
         `hasBackgroundLocationPermission()` existent dans
         `lib/core/services/location_service.dart` mais ne sont appelées nulle
         part (grep sur tout `lib/`). Elle ne servait donc à rien tout en
         déclenchant l'exigence d'information préalable.

         Le partage de position continu ne s'appuie pas dessus : il passe par
         `BackgroundLocationService`, un service de premier plan
         (`foregroundServiceType="location"` ci-dessous), qui obtient la position
         avec la seule ACCESS_FINE_LOCATION tant qu'il tourne.

         ⚠️ Si un jour on veut vraiment la position hors service de premier plan,
         il faudra RÉTABLIR cette permission **et** ajouter l'écran d'information
         préalable exigé par Google, affiché AVANT la demande système. Les deux
         vont ensemble, jamais l'une sans l'autre.

         Troisième autorisation retirée pour la même raison, après
         USE_FULL_SCREEN_INTENT et FOREGROUND_SERVICE_MEDIA_PLAYBACK : une
         permission que l'examinateur ne peut pas relier à une fonctionnalité
         visible ne passe pas. -->

    <!-- Notifications for Android 13+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Lecture audio en arrière-plan (podcasts, audio_service).
         Le plugin audio_service ne déclare RIEN dans son propre manifeste : la
         permission, le service et le receiver ci-dessous doivent être portés par
         l'app. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- FOREGROUND_SERVICE_MEDIA_PLAYBACK retirée le 2026-09-09.
         Play exige, pour chaque autorisation de service de premier plan, une
         **vidéo de démonstration** de la fonctionnalité concernée. Or le seul
         consommateur de ce service est le lecteur de podcasts
         (`PodcastAudioHandler` via `AudioService.init`), et les podcasts sont
         commentés dans `home_screen_widgets.dart` : la fonctionnalité est
         injoignable dans l'app livrée, donc infilmable. Sans la vidéo, la
         déclaration reste incomplète et la release ne peut pas être enregistrée.

         Rien de livré n'en dépend : les messages vocaux passent par `just_audio`
         directement (`audio_message_bubble.dart`), sans service de premier plan.

         ⚠️ À rétablir en même temps que les podcasts, avec la vidéo de
         démonstration correspondante. Même famille que USE_FULL_SCREEN_INTENT
         ci-dessus : une autorisation qui décrit une fonction que l'examinateur
         ne peut pas atteindre. -->

    <!-- Explicitly opt-out of Advertising ID -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove"/>

    <application
        android:label="Diaspo Niger"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:enableOnBackInvokedCallback="true">
        
        <!-- Service for background location -->
        <service
            android:name="id.flutter.flutter_background_service.BackgroundService"
            android:foregroundServiceType="location"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:enabled="true"
            />

        <!-- PAS de android:showWhenLocked ici — voir MainActivity.setShowWhenLocked().

             Le drapeau était posé statiquement dans ce manifeste pour que l'écran
             d'appel puisse s'afficher par-dessus le keyguard. Mais un attribut de
             manifeste vaut pour TOUTE la vie de l'activité, pas seulement pendant
             un appel : l'application entière (messages, notifications, profil)
             restait donc accessible par-dessus l'écran de verrouillage. Verrouiller
             le téléphone avec l'app au premier plan puis rallumer l'écran rouvrait
             Diaspo Niger sans demander le code.

             Le besoin CallKit est réel mais ponctuel : il est désormais couvert par
             setShowWhenLocked(true)/setTurnScreenOn(true) appelés à l'ouverture de
             l'écran d'appel et remis à false à sa fermeture (canal
             `diaspo_niger/lockscreen`). Même effet pendant l'appel, keyguard rendu
             le reste du temps.

             launchMode singleTask et non singleTop : vérifié sur appareil le
             2026-08-04, avec singleTop un lien reçu alors que l'app tournait
             déjà ne lui était PAS délivré — Android répondait « its current
             task has been brought to the front », ramenait la tâche au premier
             plan et jetait l'intent, sans jamais appeler onNewIntent.
             singleTask garantit la livraison à l'instance existante. C'est
             aussi ce que recommande le README de receive_sharing_intent. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- Sans ce drapeau, Flutter ignore l'URI des intents VIEW : la route
                 initiale reste « / » et un lien partagé ouvrait l'accueil au lieu
                 de son contenu. Avec, le chemin de l'URI est passé tel quel à
                 GoRouter — d'où des liens construits sur les vrais chemins de
                 l'app (`/feed/<id>`, cf. DeepLinkService.generatePostLink). -->
            <meta-data
              android:name="flutter_deeplinking_enabled"
              android:value="true"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            
            <!-- Deep Link Support: Custom Scheme -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="diasponiger" />
            </intent-filter>

            <!-- Deep Link Support: App Links (future proofing) -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="diasponiger.web.app" />
                <data android:scheme="https" android:host="diasponiger.com" />
            </intent-filter>

            <!-- Partage entrant (receive_sharing_intent) : sans ces filtres,
                 Diaspo Niger n'apparaissait pas dans le sélecteur « Partager »
                 d'Android et l'écran ShareToConversationScreen n'était
                 atteignable par aucun partage réel.

                 ⚠️ Un partage devient l'intent d'origine de la tâche : Android
                 le redonne à l'activité racine à chaque relance. La feuille ne
                 doit donc s'ouvrir qu'une fois par partage — la déduplication
                 vit dans SharedMediaService (empreinte persistée), pas ici. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="video/*" />
            </intent-filter>
            <!-- Fourre-tout : l'écran de partage sait aussi relayer un fichier
                 quelconque (MessageType.file). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="video/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>
        <!-- audio_service : service de lecture en arrière-plan et réception des
             boutons média (casque, écran de verrouillage, Bluetooth).
             MainActivity étend AudioServiceFragmentActivity, qui fournit le
             FlutterEngine partagé avec ce service. -->
        <service
            android:name="com.ryanheise.audioservice.AudioService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="true"
            tools:ignore="Instantiatable">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <receiver
            android:name="com.ryanheise.audioservice.MediaButtonReceiver"
            android:exported="true"
            tools:ignore="Instantiatable">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- Google Maps API Key - NEW TEST KEY (No App Restrictions) -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="AIzaSyCnbdymYwzJXPA2YY1PMexCU_iGaN5tPek" />
        <!-- AdMob App ID (test) -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" />

        <!-- Notifications affichées par le SDK Firebase (app en arrière-plan ou
             tuée) : sans ces deux lignes, il retombait sur @mipmap/ic_launcher,
             que la barre d'état réduit à un carré blanc (elle ne lit que le
             canal alpha). Le chemin flutter_local_notifications, lui, pointe
             déjà sur la même icône. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_accent" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
