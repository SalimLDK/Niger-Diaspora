rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }


    // Helper function to check if user owns the resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper function to validate file size (max 10MB for images, 100MB for videos)
    function isValidSize(maxSizeMB) {
      return request.resource.size < maxSizeMB * 1024 * 1024;
    }

    // Aucun objet n'occupe déjà ce chemin.
    //
    // `resource` est l'objet DÉJÀ en place ; `request.resource` celui qu'on
    // dépose. C'est la seule façon de refuser une réécriture.
    //
    // ⚠️ `allow create` NE le fait PAS, contrairement à ce que son nom laisse
    // croire : mesuré le 2026-09-21 contre l'émulateur, un `allow create` seul
    // — et même accompagné d'un `allow update: if false` — accepte la
    // réécriture d'un objet existant. Seul `resource == null` la refuse.
    // La sonde est décrite dans tools/rules_tests/medias_storage.mjs.
    function estUnDepotNeuf() {
      return resource == null;
    }

    // Types d'images acceptés, en liste FERMÉE.
    //
    // `image/.*` laissait passer `image/svg+xml` : un SVG est un document
    // exécutable, servi depuis un domaine Google avec le type qu'on lui a
    // donné. L'app pose elle-même `image/jpeg` à chaque envoi d'image ; la
    // liste reste large pour couvrir un type déduit d'une extension, sur les
    // rares envois faits sans métadonnée explicite (`putFile(file)` nu, dans
    // les datasources d'événements).
    function isImage() {
      return request.resource.contentType
        .matches('image/(jpeg|jpg|png|webp|gif|heic|heif|bmp)(;.*)?');
    }

    // Helper function to validate video file types
    function isVideo() {
      return request.resource.contentType.matches('video/.*');
    }

    // Helper function to validate audio file types
    function isAudio() {
      return request.resource.contentType.matches('audio/.*');
    }

    // Helper function to validate document file types
    function isDocument() {
      return request.resource.contentType.matches('application/pdf') ||
             request.resource.contentType.matches('application/msword') ||
             request.resource.contentType.matches('application/vnd.openxmlformats-officedocument.*') ||
             request.resource.contentType.matches('text/.*');
    }

    // ═════════════════════════════════════════════════════════════════════
    // DÉPOSER OUI, RÉÉCRIRE NON
    //
    // Les sept chemins ci-dessous n'ont aucune notion de propriétaire : leur
    // identifiant est celui d'une conversation, d'un groupe, d'une fiche —
    // pas d'une personne. Tant que `allow write` les couvrait sans réserve,
    // et comme l'URL d'un média livre son chemin, TOUT compte connecté
    // pouvait remplacer le fichier d'un autre : la photo d'un commerce,
    // l'image d'une publication, le média d'une conversation.
    //
    // Aucun envoi de l'app ne réécrit jamais — tous les noms portent un
    // horodatage à la milliseconde (`image_$timestamp.jpg`,
    // `video_$ts.mp4`, plus un aléa pour les médias chiffrés). Exiger un
    // chemin libre ne coûte donc rien.
    //
    // La suppression reste refusée, comme avant : sur un `delete`,
    // `resource` n'est pas nul (l'objet est là), donc `estUnDepotNeuf()` est
    // faux. Le ménage des médias se fait côté serveur, en Admin SDK, qui
    // ignore ces règles.
    //
    // `read` couvre `get` ET `list` : sans séparation, connaître un
    // identifiant suffit à ÉNUMÉRER le dossier. Rien dans `lib/` ne liste
    // ces chemins (le seul `listAll()` vit dans le datasource Firebase
    // hérité, hors du chemin vivant).
    //
    // Banc : tools/rules_tests/medias_storage.mjs
    // ═════════════════════════════════════════════════════════════════════

    // Profile images - users can only upload/read their own profile pictures
    match /profiles/{userId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) && isImage() && isValidSize(10);
    }

    // Message media - authenticated users can upload, size limits vary by type
    match /messages/{conversationId}/{allPaths=**} {
      // `read` couvre `get` ET `list`. Avec `allow read: if isAuthenticated()`,
      // connaître un conversationId suffisait à ÉNUMÉRER puis télécharger tout
      // le contenu média de la conversation — y compris pour un membre exclu
      // d'un groupe, qui garde l'identifiant.
      //
      // Séparer les deux ferme l'énumération : il faut désormais connaître le
      // chemin exact de l'objet (horodatage à la milliseconde + nom de
      // fichier), ce qui n'est plus découvrable depuis l'API.
      //
      // ⚠️ Ce n'est PAS la restriction aux participants. Les règles Storage ne
      // savent interroger que Firestore, or l'appartenance à une conversation
      // vit dans Supabase (`conversations.participant_ids`) depuis la
      // migration : le chemin vivant est `MessageSupabaseDataSource`, et les
      // documents Firestore `conversations` ne sont plus alimentés. Une règle
      // qui s'y fierait renverrait faux partout et casserait tous les médias.
      // Les deux vraies voies sont documentées dans
      // CHIFFREMENT_MEDIAS_PLAN.md.
      allow get: if isAuthenticated();

      // `listAll()` n'existe que dans `_deleteFilesFromStorage` du datasource
      // Firebase hérité, qui n'est plus sur le chemin vivant (le
      // `deleteConversation` de Supabase ne touche pas au Storage). Couper
      // `list` ne casse donc rien aujourd'hui.
      allow list: if false;
      allow write: if isAuthenticated() && estUnDepotNeuf() && (
        (isImage() && isValidSize(10)) ||
        (isVideo() && isValidSize(100)) ||
        (isAudio() && isValidSize(10)) ||
        (isDocument() && isValidSize(10))
      );
    }

    // Group images - authenticated users can upload
    match /groups/{groupId}/{allPaths=**} {
      allow get: if true; // Public groups may be viewable by anyone
      allow list: if false;
      allow write: if isAuthenticated() && estUnDepotNeuf()
                   && isImage() && isValidSize(10);
    }

    // Event images - authenticated users can upload
    match /events/{eventId}/{allPaths=**} {
      allow get: if true; // Events are public
      allow list: if false;
      allow write: if isAuthenticated() && estUnDepotNeuf()
                   && isImage() && isValidSize(10);
    }

    // Product images - sellers can upload
    match /products/{productId}/{allPaths=**} {
      allow get: if true; // Products are public
      allow list: if false;
      allow write: if isAuthenticated() && estUnDepotNeuf()
                   && isImage() && isValidSize(10);
    }

    // Business images - business owners can upload
    match /businesses/{businessId}/{allPaths=**} {
      allow get: if true; // Businesses are public
      allow list: if false;
      allow write: if isAuthenticated() && estUnDepotNeuf()
                   && isImage() && isValidSize(10);
    }

    // Post media (image, video, thumbnail) — ImageUploadType.post et
    // VideoUploadService.uploadPostVideo écrivent ici. Sans cette règle le
    // chemin tombait dans le deny-all final : toute publication avec média
    // échouait en `unauthorized`.
    match /posts/{postId}/{allPaths=**} {
      allow get: if true; // Posts are public
      allow list: if false;
      allow write: if isAuthenticated() && estUnDepotNeuf() && (
        (isImage() && isValidSize(10)) ||
        (isVideo() && isValidSize(100))
      );
    }

    // Story media (image, video, thumbnail) — même problème que /posts :
    // la création de story était impossible, l'échec étant avalé côté app.
    match /stories/{storyId}/{allPaths=**} {
      allow get: if isAuthenticated();
      allow list: if false;
      allow write: if isAuthenticated() && estUnDepotNeuf() && (
        (isImage() && isValidSize(10)) ||
        (isVideo() && isValidSize(100))
      );
    }

    // Pièces jointes chiffrées E2EE (MediaEncryptionService). Le contenu est
    // un blob opaque `application/octet-stream` : on ne peut donc pas valider
    // le type, seulement la taille et le propriétaire du sous-dossier.
    // La lecture reste ouverte aux comptes connectés — sans la clé de
    // conversation, l'octet-stream n'est pas exploitable.
    match /encrypted_media/{conversationId}/{senderId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isOwner(senderId) && isValidSize(100);
    }

    // Sauvegarde chiffrée des clés E2EE (KeyBackupService). Sans cette règle le
    // chemin tombait dans le deny-all final : `checkBackupPresence` échouait en
    // `unauthorized` et renvoyait donc `unknown` au lieu de `absent`, ce qui
    // fait que E2EEBackupCoordinator **sautait la génération des clés** — aucune
    // identité Signal n'était jamais créée sur un appareil sans clés locales, et
    // la messagerie restait silencieusement sur le repli AES global.
    //
    // Contrairement aux médias chiffrés, la lecture est réservée au
    // propriétaire : c'est l'identité Signal de l'utilisateur. Elle est certes
    // protégée par une passphrase (PBKDF2 200k + AES-256-GCM), mais l'exposer à
    // tout compte connecté offrirait le fichier à une attaque hors ligne.
    //
    // `create`/`update` séparés de `delete` : sur une suppression
    // `request.resource` est nul, donc `isValidSize` y échouerait et
    // `deleteBackup()` serait refusé. La réécriture reste permise ici — une
    // nouvelle sauvegarde remplace l'ancienne, et le dossier est celui de son
    // propriétaire.
    match /key_backups/{userId}/{allPaths=**} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidSize(5);
      allow delete: if isOwner(userId);
    }

    // Default deny all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
