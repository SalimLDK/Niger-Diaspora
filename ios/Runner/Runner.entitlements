<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:diasponiger.web.app</string>
		<string>applinks:diasponiger.com</string>
	</array>
	<!-- Sans cette clé, registerForRemoteNotifications échoue, getAPNSToken()
	     renvoie nil, et NotificationService._getToken() sort avant même
	     d'appeler getToken() : aucun token FCM n'était jamais enregistré sur
	     iOS, donc zéro notification.
	     ⚠️ La clé seule ne suffit pas : il faut activer la capability « Push
	     Notifications » sur l'App ID et régénérer le profil de provisionnement,
	     sinon la signature échoue. `development` ici ; Xcode bascule sur
	     `production` pour les archives App Store. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
