# Secrets / credentials — NE JAMAIS committer
serviceAccount.json
serviceAccount*.json
*serviceAccountKey*.json
# Clés de service Firebase : le nom généré par la console est du type
# <projet>-firebase-adminsdk-<hash>.json et ne matchait AUCUN motif ci-dessus.
# Ce sont des clés privées d'ADMIN (accès total Firestore/RTDB/Auth/Storage).
*firebase-adminsdk*.json
*-adminsdk-*.json
# Fichier temporaire d'injection du service account vers les secrets Supabase
.env.fcm
*.pem
*.key

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Node modules
node_modules/
functions/node_modules/

# Firebase
.firebase/

# Environment files
.env
.env.*
# ... sauf les gabarits, qui ne contiennent aucune valeur et sont le seul
# document dont un nouveau poste dispose pour reconstituer sa configuration.
!.env.example

# Claude Code local settings
.claude/settings.local.json

# Windows reserved names
nul
supabase/.temp/
