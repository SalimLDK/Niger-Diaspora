# =============================================================================
# SUPABASE EDGE FUNCTIONS — SECRETS (template)
# =============================================================================
# Copier ce fichier en ".env" dans le même dossier et remplir les valeurs.
# NE JAMAIS COMMITTER .env dans git !
#
# Développement local :
#   supabase functions serve --env-file supabase/functions/.env
#
# Pousser en production, UNE CLE A LA FOIS :
#   supabase secrets set STRIPE_SECRET_KEY=sk_live_...
#
# /!\ NE JAMAIS faire `supabase secrets set --env-file` sur ce fichier : il
# contient des valeurs d'exemple (`sk_test_...`, `AC...`), et la commande
# ECRASERAIT les vrais secrets de production par ces gabarits, sans confirmation.
#
# OU VIT QUOI (trois fichiers, trois destinations) :
#   .env                        -> l'app Flutter. PART DANS L'APK. Publiques seules.
#   functions/.env              -> Cloud Functions Firebase (Stripe, TURN, RevenueCat).
#   supabase/functions/.env     -> Edge Functions Supabase. En PRODUCTION ce
#                                  fichier ne sert a rien : les valeurs vivent
#                                  dans `supabase secrets set`. Il n'alimente
#                                  que `supabase functions serve` en local.
#
# Une meme cle reclamee par les deux runtimes serveur (STRIPE_SECRET_KEY,
# ENCRYPTION_KEY, TURN_SECRET) doit etre changee AUX DEUX ENDROITS.
#
# =============================================================================

# -----------------------------------------------------------------------------
# STRIPE
# Clés disponibles sur : https://dashboard.stripe.com/apikeys
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# -----------------------------------------------------------------------------
# FIREBASE
# Utilisé par auth-firebase-exchange pour vérifier les ID tokens Firebase.
# Valeur : nom du projet Firebase (ex. "diaspo-niger")
# -----------------------------------------------------------------------------
FIREBASE_PROJECT_ID=diaspo-niger

# -----------------------------------------------------------------------------
# TWILIO (envoi de SMS OTP)
# Compte sur : https://console.twilio.com
# -----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+...

# -----------------------------------------------------------------------------
# PUSH (Edge Function send-push -> FCM HTTP v1)
# FCM_SERVICE_ACCOUNT : JSON complet d'un service account Firebase
#   (Console Firebase > Paramètres > Comptes de service > Générer une clé privée).
#   Coller le JSON sur UNE ligne, échappé. En CLI, préférez :
#   supabase secrets set FCM_SERVICE_ACCOUNT="$(cat serviceAccount.json)"
# PUSH_WEBHOOK_SECRET : secret partagé entre la fonction et le trigger DB
#   (doit être identique à private.push_webhook_config.webhook_secret).
# -----------------------------------------------------------------------------
FCM_SERVICE_ACCOUNT={"type":"service_account","project_id":"diaspo-niger",...}
PUSH_WEBHOOK_SECRET=change-me-long-random-string


# -----------------------------------------------------------------------------
# GIFS (Edge Function gif-proxy)
# Ces deux cles portent quota et facturation : elles ne doivent JAMAIS
# retourner dans le .env racine, qui part dans l'APK.
# Renseigner au moins l'une des deux, sinon l'onglet GIFs reste vide ;
# gif-proxy repond 503 pour un fournisseur non configure et l'app bascule
# automatiquement sur l'autre.
#   Tenor : Google Cloud Console > activer "Tenor API" > creer une cle
#   Giphy : https://developers.giphy.com > Create an App > API Key
# -----------------------------------------------------------------------------
TENOR_API_KEY=
GIPHY_API_KEY=

# =============================================================================
# NOTE : SUPABASE_URL et SUPABASE_SERVICE_ROLE_KEY sont auto-injectés par le
# runtime Supabase — inutile de les définir ici pour la production.
# Pour le développement local, supabase start les injecte automatiquement.
# =============================================================================
