{
    "flutter": {
        "platforms": {
            "android": {
                "default": {
                    "projectId": "diaspo-niger",
                    "appId": "1:539228418594:android:64adecd6aa5e20368e507b",
                    "fileOutput": "android/app/google-services.json"
                }
            },
            "dart": {
                "lib/firebase_options.dart": {
                    "projectId": "diaspo-niger",
                    "configurations": {
