{
    "flutter": {
        "platforms": {
            "android": {
                "default": {
                    "projectId": "diaspo-niger",
                    "appId": "1:539228418594:android:64adecd6aa5e20368e507b",
                    "fileOutput": "android/app/google-services.json"
                }
            },
            "dart": {
                "lib/firebase_options.dart": {
                    "projectId": "diaspo-niger",
                    "configurations": {
                        "android": "1:539228418594:android:64adecd6aa5e20368e507b",
                        "ios": "1:539228418594:ios:6cdc9491c795c4a38e507b",
                        "web": "1:539228418594:web:3b01752fce9a0e328e507b"
                    }
                }
            }
        }
    },
    "firestore": {
        "rules": "firestore.rules",
        "indexes": "firestore.indexes.json"
    },
    "database": {
        "rules": "database.rules.json"
    },
    "storage": {
        "rules": "storage.rules"
    },
    "functions": {
        "source": "functions"
    },
    "hosting": [
        {
            "site": "diaspo-niger",
            "public": "public",
            "ignore": [
                "firebase.json",
                "**/node_modules/**"
            ],
            "rewrites": [
                {
                    "source": "**",
                    "destination": "/index.html"
                }
            ],
            "headers": [
                {
                    "source": "**/*.@(jpg|jpeg|gif|png|svg|webp|ico)",
                    "headers": [
                        {
                            "key": "Cache-Control",
                            "value": "public, max-age=3600"
                        }
                    ]
                },
                {
                    "source": "**/*.@(html)",
                    "headers": [
                        {
                            "key": "Cache-Control",
                            "value": "public, max-age=0, must-revalidate"
                        }
                    ]
                }
            ]
        },
        {
            "site": "diaspo-niger-admin",
            "public": "build/web-admin",
            "ignore": [
                "firebase.json",
                "**/.*",
                "**/node_modules/**"
            ],
            "rewrites": [
                {
                    "source": "**",
                    "destination": "/index.html"
                }
            ],
            "headers": [
                {
                    "source": "**/*.@(js|css)",
                    "headers": [
                        {
                            "key": "Cache-Control",
                            "value": "max-age=31536000"
                        }
                    ]
                }
            ]
        }
    ]
}