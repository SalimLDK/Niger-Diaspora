{
    "rules": {
        "presence": {
            "$userId": {
                ".read": "auth != null",
                ".write": "auth != null && auth.uid === $userId",
                "isOnline": {
                    ".validate": "newData.isBoolean()"
                },
                "lastSeen": {
                    ".validate": "newData.isNumber()"
                }
            }
        },
        "conversations": {
            "$conversationId": {
                "participants": {
                    ".read": "auth != null && data.hasChild(auth.uid)",
                    ".write": "auth != null && (!data.exists() || data.hasChild(auth.uid))"
                }
            }
        },
        "messages": {
            "$conversationId": {
                ".indexOn": [
                    "createdAt"
                ],
                ".read": "auth != null && root.child('conversations').child($conversationId).child('participants').hasChild(auth.uid)",
                ".write": "auth != null && root.child('conversations').child($conversationId).child('participants').hasChild(auth.uid)",
                "$messageId": {
                    ".validate": "newData.hasChildren(['senderId', 'content', 'type', 'createdAt']) && newData.child('senderId').val() === auth.uid",
                    "content": {
                        ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length < 10000"
                    },
                    "type": {
                        ".validate": "newData.isString() && (newData.val() === 'text' || newData.val() === 'image' || newData.val() === 'audio' || newData.val() === 'video' || newData.val() === 'file')"
                    },
                    "createdAt": {
                        ".validate": "newData.isString()"
                    },
                    "senderId": {
                        ".validate": "newData.isString() && newData.val() === auth.uid"
                    }
                }
            }
        },
        "typing": {
            "$conversationId": {
                ".read": "auth != null && root.child('conversations').child($conversationId).child('participants').hasChild(auth.uid)",
                "$userId": {
                    ".write": "auth != null && auth.uid === $userId && root.child('conversations').child($conversationId).child('participants').hasChild(auth.uid)",
                    ".validate": "newData.isBoolean()"
                }
            }
        },
        "$other": {
            ".read": false,
            ".write": false
        }
    }
}