# =============================================================================
# DIASPO NIGER - FIREBASE FUNCTIONS ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env and fill in the values
# IMPORTANT: Never commit .env to git!
#
# OU VIT QUOI (trois fichiers, trois destinations) :
#   .env                        -> l'app Flutter. PART DANS L'APK. Publiques seules.
#   functions/.env              -> Cloud Functions Firebase (Stripe, TURN, RevenueCat).
#   supabase/functions/.env     -> Edge Functions Supabase. En PRODUCTION ce
#                                  fichier ne sert a rien : les valeurs vivent
#                                  dans `supabase secrets set`. Il n'alimente
#                                  que `supabase functions serve` en local.
#
# Une meme cle reclamee par les deux runtimes serveur (STRIPE_SECRET_KEY,
# ENCRYPTION_KEY, TURN_SECRET) doit etre changee AUX DEUX ENDROITS.
#
# =============================================================================

# -----------------------------------------------------------------------------
# STRIPE CONFIGURATION
# -----------------------------------------------------------------------------
# Get your keys from: https://dashboard.stripe.com/apikeys
# Use sk_test_* for development, sk_live_* for production
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Stripe Webhook Secret
# Get from: https://dashboard.stripe.com/webhooks
# Create endpoint: https://us-central1-diaspo-niger.cloudfunctions.net/stripeWebhook
# Events: payment_intent.succeeded, payment_intent.payment_failed
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# -----------------------------------------------------------------------------
# ENCRYPTION CONFIGURATION
# -----------------------------------------------------------------------------
# AES-256 encryption key for message encryption/decryption
# CRITICAL: This key MUST match the Flutter app's EncryptionService key
# Changing this will break decryption of existing messages!
# Key must be exactly 32 characters for AES-256
ENCRYPTION_KEY=your_32_character_encryption_key

# -----------------------------------------------------------------------------
# REVENUECAT CONFIGURATION
# -----------------------------------------------------------------------------
# Get your webhook authorization header from:
# RevenueCat Dashboard → Project → Integrations → Webhooks
# Create endpoint: https://us-central1-[PROJET].cloudfunctions.net/revenueCatWebhook
REVENUECAT_WEBHOOK_AUTH=your_revenuecat_webhook_auth_header_here

# -----------------------------------------------------------------------------
# TURN SERVER CONFIGURATION
# -----------------------------------------------------------------------------
# Shared secret for generating ephemeral TURN credentials (HMAC-SHA1).
# This MUST match the coturn server's static-auth-secret setting.
# Generate with: openssl rand -base64 32
TURN_SECRET=your_turn_shared_secret_here

# -----------------------------------------------------------------------------
# SUPABASE (lecture serveur des tokens/profils/conversations pour les pushes)
# -----------------------------------------------------------------------------
# Les Cloud Functions de notification (onCallCreated, onCallUpdated,
# onMessageCreated) lisent les tokens FCM et les profils dans Supabase, pas dans
# Firestore. Sans ces 2 variables, les pushes d'appel et de message sont muets.
#
# SUPABASE_URL         : URL du projet (NON secrète — même valeur que l'app).
# SUPABASE_SERVICE_KEY : clé SECRÈTE côté serveur (nouvelle "secret key"
#                        sb_secret_… du dashboard Supabase → Settings → API).
#                        Accès total (bypass RLS) — ne JAMAIS l'exposer côté app.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=sb_secret_your_supabase_secret_key_here
